; Title font image. It is not part of the runtime: start copies it into
; the charset cells from TITLE_FONT_CHAR on, which neither the game nor
; the title screen uses for anything else.
; 7 x 5 glyphs in code order, pixel rows 1..5 of the cell, column 7 free.
title_font_image:
!byte 0, 0, 0, 0, 0                                          ; blank
!byte %.#####.., %##...##., %#######., %##...##., %##...##.  ; A
!byte %.######., %##......, %##......, %##......, %.######.  ; C
!byte %#######., %##......, %#####..., %##......, %#######.  ; E
!byte %#######., %##......, %#####..., %##......, %##......  ; F
!byte %.######., %##......, %##..###., %##...##., %.######.  ; G
!byte %.#####.., %..###..., %..###..., %..###..., %.#####..  ; I
!byte %##......, %##......, %##......, %##......, %#######.  ; L
!byte %##...##., %###.###., %##.#.##., %##...##., %##...##.  ; M
!byte %##...##., %###..##., %##.#.##., %##..###., %##...##.  ; N
!byte %.#####.., %##...##., %##...##., %##...##., %.#####..  ; O
!byte %######.., %##...##., %######.., %##......, %##......  ; P
!byte %######.., %##...##., %######.., %##..##.., %##...##.  ; R
!byte %.######., %##......, %.#####.., %.....##., %######..  ; S
!byte %#######., %..###..., %..###..., %..###..., %..###...  ; T
!byte %##...##., %##...##., %.#####.., %..###..., %..###...  ; Y
!byte %.#####.., %##..###., %##.#.##., %###..##., %.#####..  ; 0
!byte %..###..., %.####..., %..###..., %..###..., %#######.  ; 1
!byte %######.., %.....##., %.#####.., %##......, %#######.  ; 2
!byte %######.., %.....##., %..####.., %.....##., %######..  ; 3
!byte %##...##., %##...##., %#######., %.....##., %.....##.  ; 4
!byte %#######., %##......, %######.., %.....##., %######..  ; 5
!byte %.#####.., %##......, %######.., %##...##., %.#####..  ; 6
!byte %#######., %.....##., %....##.., %...##..., %..##....  ; 7
!byte %.#####.., %##...##., %.#####.., %##...##., %.#####..  ; 8
!byte %.#####.., %##...##., %.######., %.....##., %.#####..  ; 9
!byte %..###..., %.#.###.., %.#####.., %.#####.., %..###...  ; ball
!if * - title_font_image != TITLE_GLYPHS * 5 { !error "one glyph per title glyph code" }

